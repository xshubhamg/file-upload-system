# Copy to .env. The values below are development defaults and are NOT safe for
# production. Generate secrets with: openssl rand -base64 48

APP_ENV=development
APP_NAME=file-upload
PORT=8080
ADMIN_PORT=9090
LOG_LEVEL=debug
LOG_FORMAT=text

# Host ports used by docker compose. Change these if something else is using
# the defaults. The API and admin ports inside the containers stay 8080/9090.
# If you change POSTGRES_HOST_PORT or S3MOCK_HOST_PORT, also update
# DATABASE_URL and S3_ENDPOINT/S3_PUBLIC_ENDPOINT below to match.
API_HOST_PORT=8080
ADMIN_HOST_PORT=9090
POSTGRES_HOST_PORT=5432
S3MOCK_HOST_PORT=9091

# Postgres. When running the API on the host, use localhost. Docker Compose
# overrides this with the service name "postgres".
DATABASE_URL=postgres://fileupload:fileupload@localhost:5432/file_upload?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
AUTO_MIGRATE=true

# Independent HMAC secrets, at least 32 characters each. Rotating these logs
# everyone out (access tokens) and invalidates refresh token hashes.
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12

# Upload policy.
MAX_UPLOAD_BYTES=104857600
MAX_JSON_BODY_BYTES=1048576
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,text/plain,text/csv,application/json,application/zip,video/mp4,audio/mpeg
PENDING_UPLOAD_TTL=1h
CLEANUP_INTERVAL=10m

# Object storage. S3Mock locally, AWS S3 (or another S3-compatible service) in
# production. MinIO works in production but its public Docker images were
# withdrawn, so the local stack uses S3Mock. S3_PUBLIC_ENDPOINT is the host
# clients use for presigned URLs.
S3_ENDPOINT=localhost:9091
S3_PUBLIC_ENDPOINT=localhost:9091
S3_REGION=us-east-1
S3_BUCKET=file-upload
S3_ACCESS_KEY=s3mock-access
S3_SECRET_KEY=s3mock-secret
S3_USE_SSL=false
S3_PUBLIC_USE_SSL=false
S3_AUTO_CREATE_BUCKET=true
PRESIGN_UPLOAD_TTL=15m
PRESIGN_DOWNLOAD_TTL=5m

# HTTP hardening.
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=127.0.0.1,::1
COOKIE_SECURE=false
COOKIE_DOMAIN=
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
AUTH_RATE_LIMIT_RPS=5
AUTH_RATE_LIMIT_BURST=10
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
METRICS_ENABLED=true
